{{ layout "layouts/main.vto" { title: `Build - ${title}` } }}
<h1>{{ title }}</h1>
<h2>Profile</h2>
{{ set statusObj = buildGlossary.statuses.find(i => i.id === status)}}
<p>Status: {{ statusObj?.label ?? 'Draft' }}</p>
{{ if description }}<p>{{ description }}</p>{{ /if }}
{{ if playstyle }}
<ul>
{{ for item of playstyle }}
	<li>{{ item }}</li>
{{ /for }}
</ul>
{{ /if }}
<h3>Attributes</h3>
{{ if attributes }}
<ul g="attr-tag-list">
{{ for item of attributes }}
	{{ if typeof item === "string" }}
		{{ set attr = buildGlossary.attributes.find(i => i.id === item) }}
		{{ if attr }}<li g="attr-tag" data-type="{{ attr.type }}">{{ attr?.label }}</li>{{ /if }}
	{{ else if Array.isArray(item) && item.length > 0 }}
		{{ set attr = buildGlossary.attributes.find(i => i.id === item[0]) }}
		{{ set rest = item.slice(1) }}
		{{ if attr }}
		<li g="attr-tag" data-type="{{ attr.type }}">{{ attr?.label }}
		{{ if rest }}
			<ul>
				{{ for item of rest }}
				{{ set attr = buildGlossary.attributes.find(i => i.id === item) }}
				{{ if attr }}<li data-type="{{ attr.type }}">{{ attr?.label }}</li>{{ /if }}
				{{ /for }}
			</ul>
		{{ /if }}
		</li>
		{{ /if }}
	{{ /if }}
{{ /for }}
</ul>
{{ /if }}
<h2>Subclass & Abilities</h2>
{{ set cls = buildGlossary.classes.find(i => i.id === build.class) }}
{{ set sub = buildGlossary.subclasses.find(i => i.id === build.subclass) }}
{{ set subEle = sub ? buildGlossary.elements.find(i => i.id === sub.element) : null }}
{{ if cls && sub && subEle }}
<p>{{ cls.label }} / {{ sub.label }} ({{ subEle?.label }})</p>
{{ if build.abilities }}
	<h3>Abilities</h3>
	<dl>
		{{ for key of ["super", "grenade", "melee", "class", "movement"] }}
		{{ set ability = build.abilities[key] }}
		{{ set abilityType = buildGlossary.abilityTypes.find(i => i.id === key) }}
		<dt>{{ abilityType ? abilityType.label : key }}</dt>
		<dd>{{ ability ?? "<i>Any</i>" }}</dd>
		{{ /for }}
	</dl>
{{ /if }}
{{ if build.fragments }}
<h3>Fragments</h3>
<ul>
	{{ for fragment of build.fragments }}
	<li>{{ subEle.fragmentPrefix }} of {{ fragment }}</li>
	{{ /for }}
</ul>
{{ /if }}
{{ if build.aspects }}
<h3>Aspects</h3>
<ul>
	{{ for aspect of build.aspects }}
	<li>{{ aspect }}</li>
	{{ /for }}
</ul>
{{ /if }}
{{ /if }}
<h2>Gear</h2>
{{ if build.weapons }}
<h3>Weapons</h3>
<dl g="build-weapons">
	{{ for key, value of build.weapons }}
	{{ set weaponSlot = buildGlossary.weaponSlots.find(i => i.id === key) }}
	<dt>{{ weaponSlot?.label || key }}</dt>
	<dd>
		<span part="ammo">{{ key === "power" ? 'heavy' : value.ammo }} ammo</span>
		<div part="img"></div>
		<span part="name">
		{{ if value.name }}
		{{ value.name }}
		{{ else if value.type && value.subtype }}
		<span part="subtype">{{ value.subtype }}</span>
		{{ value.type }}
		{{ /if }}
		</span>
		{{ if value.element }}<span part="element">{{ value.element }}</span>{{ /if }}
		{{ if value.perks || value.mod }}
		<div part="perks"><span>Perks/Mods</span>
		<ul>
			{{ if value.mod }}<li>Mod: {{ value.mod }}</li>{{ /if }}
			{{ for perk of value.perks }}<li>Perk: {{ perk }}</li>{{ /for }}
		</ul>
		</div>
		{{ /if }}
	</dd>
	{{ /for }}
</dl>
{{ /if }}
{{ if build.stats }}
<h3>Stats Priority</h3>
<ol>
	{{ for key, value of build.stats }}
	{{ set stat = buildGlossary.stats.find(i => i.id === key) }}
	{{ if stat }}<li>{{ stat.label }}{{ if value }} {{ value }}+{{ /if }}</li>{{ /if }}
	{{ /for }}
</ol>
{{ /if }}
{{ if build.armor }}
<h3>Armor</h3>
<dl>
{{ if build.armor.exotic }}
	<dt>Exotic</dt>
	<dd>{{ build.armor.exotic }}</dd>
{{ /if }}
{{ if build.armor.set }}
	<dt>Set Bonus</dt>
	<dd>
{{ if build.armor.set.length === 1 }}
{{ build.armor.set[0] }} x4
{{ else if build.armor.set.length === 2 }}
{{ build.armor.set[0] }} x2, {{ build.armor.set[1] }} x2
	</dd>
{{ /if }}
{{ if build.armor.mods }}
	<dt>Mods</dt>
	<dd>
		<dl>
		{{ for key, value of build.armor.mods }}
		{{ set armorSlot = buildGlossary.armorSlots.find(i => i.id === key) }}
			<dt>{{ armorSlot?.label ?? key }}</dt>
			<dd>{{ value.join(', ') }}</dd>
		{{ /for }}
		</dl>
	</dd>
{{ /if }}
</dl>
{{ /if }}
</p>
{{ /if }}
<h2>Cosmetics</h2>
<table>
	<thead>
		<tr>
			<th colspan="2">Slot</th>
			<th>Item/Ornament</th>
			<th>Shader</th>
			<th>Extra</th>
		</tr>
	</thead>
	<tbody>
		{{ set i = 0 }}
		{{ set length = Object.keys(cosmetics.armor).length }}
		{{ for key, value of cosmetics.armor }}
		{{ set classes = {
			'armor-end': i === length - 1,
			exotic: key === build.armor.exoticSlot
		} |> classes }}
		{{ set armorSlot = buildGlossary.armorSlots.find(i => i.id === key) }}
		<tr{{ if classes }} class="{{ classes }}"{{ /if }}>
			{{ if i === 0 }}<th rowspan="{{ length }}">Armor</th>{{ /if }}
			<th>{{ armorSlot.label }}</th>
			<td>{{ value.ornament || '-' }}</td>
			<td>{{ value.shader || '-' }}</td>
			<td>-</td>
		</tr>
		{{ set i = i + 1 }}
		{{ /for }}
		{{ set i = 0 }}
		{{ set length = Object.keys(cosmetics.weapons).length }}
		{{ for key, value of cosmetics.weapons }}
		{{ set classes = {
			'weapons-end': i === length - 1,
			exotic: key === build.armor.exoticSlot
		} |> classes }}
		{{ set weaponSlot = buildGlossary.weaponSlots.find(i => i.id === key) }}
		<tr{{ if classes }} class="{{ classes }}"{{ /if }}>
			{{ if i === 0 }}<th rowspan="{{ length }}">Weapons</th>{{ /if }}
			<th>{{ weaponSlot.label }}</th>
			<td>{{ value.ornament || '-' }}</td>
			<td>{{ value.shader || '-' }}</td>
			<td>-</td>
		</tr>
		{{ set i = i + 1 }}
		{{ /for }}
		{{ if cosmetics.ghost }}
		<tr>
			<th colspan="2">Ghost</th>
			<td>{{ cosmetics.ghost.shell || '-' }}</td>
			<td>{{ cosmetics.ghost.shader || '-' }}</td>
			<td>{{ cosmetics.ghost.projection ? `Projection: ${cosmetics.ghost.projection}` : '-' }}</td>
		</tr>
		{{ /if }}
		{{ if cosmetics.ship }}
		<tr>
			<th colspan="2">Ship</th>
			<td>{{ cosmetics.ship.name || '-' }}</td>
			<td>{{ cosmetics.ship.shader || '-' }}</td>
			<td>{{ cosmetics.ship.transmat ? `Transmat Effect: ${cosmetics.ship.transmat}` : '-' }}</td>
		</tr>
		{{ /if }}
		{{ if cosmetics.vehicle }}
		<tr>
			<th colspan="2">Vehicle</th>
			<td>{{ cosmetics.vehicle.name || '-' }}</td>
			<td>{{ cosmetics.vehicle.shader || '-' }}</td>
			<td>-</td>
		</tr>
		{{ /if }}
		{{ if cosmetics.emblem }}
		<tr>
			<th colspan="2">Emblem</th>
			<td>{{ cosmetics.emblem || '-' }}</td>
			<td>-</td>
			<td>-</td>
		</tr>
		{{ /if }}
	</tbody>
</table>
{{ /layout }}