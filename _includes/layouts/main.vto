<!doctype html>

<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>{{ title }}</title>
		<meta
			name="viewport"
			content="initial-scale=1.0, width=device-width, height=device-height"
		/>
		<link href="/assets/style.css" rel="stylesheet" type="text/css" />
		<link rel="icon" href="/assets/images/logo/favicon.svg" />
	</head>

	<body>
		<header g="site-header" g-layout="prose" prose-align="center-block">
			<nav>
				<ul g="menu">
					<li>
						<a href="/"><img part="logo" src="/assets/images/logo/glyph-gold.svg" alt="guardian's field guide logo glyph" width="90" height="140"> <span>Home</span></a>
					</li>
					<li>
						<a href="/guided-path/">Guided Path</a>
					</li>
					<li>
						<a href="/manual/">Manual</a>
					</li>
					<li>
						<a href="/story/">Story</a>
					</li>
					<li>
						<a href="/major-changes/">Major Changes</a>
					</li>
					<li>
						<a href="/extra/">Extra</a>
					</li>
				</ul>
			</nav>
		</header>
		<main>
			{{ content }}
		</main>
		<footer g="site-footer">
			<p>Guardian's Field Guide</p>
			<p>Last updated on October 13, 2026 for v9.7.0</p>
		</footer>
		<script src="/assets/script.js"></script>
	</body>
</html>
