<!doctype html>

<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>{{ title }}</title>
		<meta
			name="viewport"
			content="initial-scale=1.0, width=device-width, height=device-height"
		/>
		<link href="/assets/style.css" rel="stylesheet" type="text/css" />
		<link rel="icon" href="/assets/images/logo/favicon.svg" />
		<link rel="canonical" href="{{ url |> url(true) }}" />
	</head>

	<body>
		<header g="site-header" g-layout="prose" prose-align="center-block">
			<nav>
				<ul g="menu">
					<li>
						<a href="/"><img part="logo" src="/assets/images/logo/glyph-gold.svg" alt="guardian's field guide logo glyph" width="90" height="140"> <span>Home</span></a>
					</li>
					<li>
						<a href="/guided-path/">Guided Path</a>
					</li>
					<li>
						<a href="/manual/">Manual</a>
					</li>
					<li>
						<a href="/story/">Story</a>
					</li>
					<li>
						<a href="/major-changes/">Major Changes</a>
					</li>
					<li>
						<a href="/extra/">Extra</a>
					</li>
				</ul>
			</nav>
		</header>
		<main>
			{{ content }}
		</main>
		<footer g="site-footer" g-layout="prose" prose-space="compact" prose-align="center">
			<p><a href="/"><img part="logo" src="/assets/images/logo/logotype-single-centered-multicolor.svg" alt="guardian's field guide home" width="590" height="140"></a></p>
			<p>Written by <a href="https://github.com/stormalize/guardians-field-guide">Stormalize</a>. Last updated on October 14, 2026 for <b>v9.7.0.5</b></p>
		</footer>
		<script src="/assets/script.js"></script>
	</body>
</html>
