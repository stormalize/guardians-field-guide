{{ layout "layouts/main.vto" { title: `Build - ${title}` } }}
<m-container m-layout="prose" prose-align="center-block">
	<h1>{{ title }}</h1>
	<p>Destiny has changed a lot over the years and unfortunately the early parts of Destiny 2 have been removed, as well as seasonal content that bridged the gaps between major expansions. This page serves as a guide to the entirety of the story (including Destiny 1 for completeness), providing a quick reference for the order of the many releases as well as recaps of portions that have been removed.</p>
	<p>There is an in-game timeline in the Director which you may also refer to, however it does not include a way to watch cutscenes or get a synopsis of key characters if you would like to explore those.</p>
	<m-callout><p>Seasonal recaps <img m="icon" src="/assets/images/icons/extra/seasons-collection.png" alt=""> that follow playable expansions may contain minor spoilers for preceding campaigns.</p></m-callout>
	<m-story prose-width="wide">
		{{ for game of games }}
		<section part="game">
			<p><span><img m="icon" src="./game-icon.png"> {{ game.title }}</span></p>
			{{ for book of game.books }}
			<div part="book">
				<h2>{{ book.title }}{{ if book.subtitle }}<br>{{ book.subtitle }}{{ /if }}</h2>
				<ol>
					{{ for release of book.releases }}
					<li data-type="{{ release.type }}">
						<img m="icon" src="/assets/images/icons/{{ release.icon }}">
						<p>{{ release.title }}</p>
						<button commandfor="{{ release.id }}" command="show-modal">{{ release.activity }}</button>
						<dialog id="{{ release.id }}">
							<div part="header">
							<h2><img m="icon" src="/assets/images/icons/{{ release.icon }}"> {{ release.title }}</h2>
							{{ if release.subtitle }}<p>{{ release.subtitle }}</p>{{ /if }}
							</div>
							<div part="nav" role="tablist">
								<button
									id="{{ release.id }}-tab-overview"
									role="tab"
									aria-controls="{{ release.id }}-tabpanel-overview"
									aria-selected="true"
								>
									Overview
								</button>
								<button
									id="{{ release.id }}-tab-characters"
									role="tab"
									aria-controls="{{ release.id }}-tabpanel-characters"
								>
									Characters
								</button>
							</div>
							{{# story synopsis #}}
							<div
								id="{{ release.id }}-tabpanel-overview"
								aria-labelledby="{{ release.id }}-tab-overview"
								part="content"
								m-layout="prose"
							>
								<div m="story-entry">
									<p>{{ release.synopsis }}</p>
									<ol part="actions">
									{{ for action of release.actions }}
										<li>
											{{ if action.type === "cutscene-archive" }}
											<a href="#"><img m="icon" src="/assets/images/icons/extra/lore-book.png"> {{ action.title }}</a>
											{{ else }}
											<span><img m="icon" src="/assets/images/icons/extra/lore-book.png"> {{ action.title }}</span>
											{{ /if }}
										</li>
									{{ /for }}
									</ol>
								</div>
							{{ if release.entries }}<ol variant="headings">
							{{ for entry of release.entries }}
								<li m="story-entry">
									<h3 part="header"><img m="icon" src="/assets/images/icons/{{ entry.icon }}"> {{ entry.title }}</h3>
									{{ if entry.synopsis }}<p>{{ entry.synopsis }}</p>{{ /if }}
									<ol part="actions">
									{{ for action of entry.actions }}
										<li>
											{{ if action.type === "cutscene-archive" }}
											<a href="#"><img m="icon" src="./entry-icon.png"> {{ action.title }}</a>
											{{ else }}
											<span><img m="icon" src="./entry-icon.png"> {{ action.title }}</span>
											{{ /if }}
										</li>
									{{ /for }}
									</ol>
								</li>
							{{ /for }}
							</ol>{{ /if }}
							</div>
							{{# character synopsis #}}
							<div
								id="{{ release.id }}-tabpanel-characters"
								aria-labelledby="{{ release.id }}-tab-characters"
								part="content"
								m-layout="prose"
								hidden=""
							>
								<ul m-layout="grid" variant="plain">
								{{ for character of release.characters }}
									<li m="person">
										<img src="{{ character.image }}">
										<span part="name">{{ character.name }}</span>
										<span part="title">{{ character.title }}</span>
										<span part="description">{{ character.description }}</span>
									</li>
								{{ /for }}
								</ul>
							{{ if release.entries }}<ol variant="headings">
							{{ for entry of release.entries }}
								<li m="story-entry">
									<h3 part="header"><img m="icon" src="/assets/images/icons/{{ entry.icon }}"> {{ entry.title }}</h3>
									<ul m-layout="grid" variant="plain">
										{{ for character of entry.characters }}
											<li m="person">
												<img src="{{ character.image }}">
												<span part="name">{{ character.name }}</span>
												<span part="title">{{ character.title }}</span>
												<span part="description">{{ character.description }}</span>
											</li>
										{{ /for }}
									</ul>
								</li>
							{{ /for }}
							</ol>{{ /if }}
							</div>
							<button commandfor="{{ release.id }}" command="close">Close</button>
						</dialog>
					</li>
					{{ /for }}
				</ol>
			</div>
			{{ /for }}
		</section>
		{{ /for }}
	</m-story>
</m-container>
{{ /layout }}