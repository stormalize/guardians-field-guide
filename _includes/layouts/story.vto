{{ layout "layouts/default-page.vto" }}
	<p>The stories tell of a golden age long ago, when our civilization spanned the system. It was a bright and hopeful time. But it didn't last. Something hit us. Knocked us down and tried to stamp us out. No one knows exactly what, but we do know this: very few of us survived, and those that did owe their lives to The Traveler.</p>
	<p>Legends say The Traveler sacrificed itself to save us. The mysterious sphere still hangs where it made its last stand, low above the Earth, keeping silent watch. The years that followed the collapse of the golden age were hard, but slowly we joined together to build a city beneath The Traveler. And now we've begun to venture back into the wild, only to find that we're not alone. Strange and deadly creatures have occupied our old worlds. And they're pressing hard against The City, probing for a weakness, trying to wipe us out for good.</p>
	<details g-layout="prose" prose-space="compact">
		<summary>How to Use This Story Guide</summary>
		<p>While there is an in-game timeline in the Director which you may also refer to, this page serves as a more comprehensive guide to the entirety of the story (including Destiny 1 for completeness), providing a quick reference for the order of the many releases as well as recaps of portions that have been removed.</p>
		<p>This enhanced timeline includes character lists and additional resources to explore the story further. Resources such as related in-game quests, other activities, or cutscene archives are categorized as follows:</p>
		<ul>
	{{ for actionType of actionTypes }}
		<li><img g="icon" src="/assets/images/icons/{{ actionType.icon }}"> <strong>{{ actionType.label }}</strong> - {{ actionType.description }}</li>
	{{ /for }}
	</ul>
	</details>
	<g-callout><p>Seasonal recaps <img g="icon" src="/assets/images/icons/extra/seasons-collection.png" alt=""> that follow playable expansions may contain minor spoilers for preceding campaigns.</p></g-callout>
	<g-callout><p>For additional explanation of Guardians, enemies, and more in the world of Destiny, increase your <a href="/manual/#guardian-ranks">Guardian Rank</a> and view <b>The Vanguard</b> lore category in "Collections > Lore" in your Character screen.</p></g-callout>
	<g-story prose-width="wide">
		{{ for game of games }}
		<section part="game">
			<p><span><img g="icon" src="/assets/images/icons/{{ game.icon }}"> {{ game.title }}</span></p>
			{{ for book of game.books }}
			<div part="book">
				<h2>{{ book.title }}{{ if book.subtitle }}<br>{{ book.subtitle }}{{ /if }}</h2>
				<ol>
					{{ for release of book.releases }}
					<li data-type="{{ release.type }}" data-playable="{{ release.playable }}">
						<img g="icon" src="/assets/images/icons/{{ release.icon }}">
						<p>{{ if release.subtitle }}<span>{{ release.subtitle }}<br></span>{{ /if }}{{ release.title }}</p>
						<button commandfor="{{ release.id }}" command="show-modal"{{ release.playable ? ' variant="glow"' : '' }}>{{ release.playable ? 'Play' : 'Recap' }}</button>
						<dialog id="{{ release.id }}">
							{{ set hasCharacters = release.characters?.length > 0 || release.entries?.filter((entry) => entry?.characters.length > 0).length > 0 }}
							<div part="header">
							<h2><img g="icon" src="/assets/images/icons/{{ release.icon }}"> {{ release.title }}</h2>
							{{ if release.subtitle }}<p><i>{{ release.subtitle }}</i></p>{{ /if }}
							</div>
							<div part="nav" role="tablist" variant="banner"{{ if release.banner }} style="--tab-banner-img: url('/assets/images/banners/{{ release.banner }}')"{{ /if }}>
								<button
									id="{{ release.id }}-tab-overview"
									role="tab"
									aria-controls="{{ release.id }}-tabpanel-overview"
									aria-selected="true"
								>
									Overview
								</button>
								{{ if hasCharacters }}
								<button
									id="{{ release.id }}-tab-characters"
									role="tab"
									aria-controls="{{ release.id }}-tabpanel-characters"
								>
									Characters
								</button>
								{{ /if }}
							</div>
							{{# story synopsis #}}
							{{ set hasEntries = release.entries?.length > 0 }}
							<div
								id="{{ release.id }}-tabpanel-overview"
								aria-labelledby="{{ release.id }}-tab-overview"
								part="content"
								g-layout="prose"
								{{ if hasEntries }}scroll-group="{{ release.id }}"{{ /if }}
							>
								{{ if release.synopsis || release.quote || release.actions }}
								<div g="story-entry">
									<div part="summary" g-layout="prose" prose-layout="compact">
										{{ if release.quote }}
										<blockquote>
											<p>{{ release.quote }}</p>
											{{ if release.quoteCaption }}<p><cite>{{ release.quoteCaption }}</cite></p>{{ /if }}
										</blockquote>
										{{ /if }}
										<p>{{ release.synopsis }}</p>
										{{ if release.synopsisFull }}
										<details>
											<summary>Plot Summary</summary>
											<p>{{ release.synopsisFull }}</p>
										</details>
										{{ /if }}
									</div>
									<div part="actions">
										{{ if release.previewActions }}
										<p><span class="fmt-label">Preview</span></p>
										<ol class="supplemental">
										{{ for action of release.previewActions }}
											{{ set actionType = Object.hasOwn(actionTypes, action.type) ? actionTypes[action.type] : {} }}
											<li>
												{{ if action.url }}
												<a{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}} href="{{ action.url }}" target="_blank">
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}{{ action.length ? ` • ${action.length}` : "" }}</span>
													<span>{{ action.title }}</span>
												</a>
												{{ else }}
												<span{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}}>
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}</span>
													<span>{{ action.title }}</span>
												</span>
												{{ /if }}
											</li>
										{{ /for }}
										</ol>
										{{ /if }}
										{{ if release.actions }}
										<p><span class="fmt-label">Core Content</span></p>
										<ol>
										{{ for action of release.actions }}
											{{ set actionType = Object.hasOwn(actionTypes, action.type) ? actionTypes[action.type] : {} }}
											<li>
												{{ if action.url }}
												<a target="_blank"{{ action.description ? ` title="${action.description}"` : ''}} href="{{ action.url }}" target="_blank">
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}{{ action.length ? ` • ${action.length}` : "" }}</span>
													<span>{{ action.title }}</span>
												</a>
												{{ else }}
												<span{{ action.description ? ` title="${action.description}"` : ''}}>
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}{{ action.missionType ? ` / ${action.missionType}` : "" }}</span>
													<span>{{ action.title }}</span>
												</span>
												{{ /if }}
											</li>
										{{ /for }}
										</ol>
										{{ /if }}
										{{ if release.supplementalActions }}
										<p><span class="fmt-label">Additional Content</span></p>
										<ol class="supplemental">
										{{ for action of release.supplementalActions }}
											{{ set actionType = Object.hasOwn(actionTypes, action.type) ? actionTypes[action.type] : {} }}
											<li>
												{{ if action.url }}
												<a{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}} href="{{ action.url }}" target="_blank">
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}{{ action.length ? ` • ${action.length}` : "" }}</span>
													<span>{{ action.title }}</span>
												</a>
												{{ else }}
												<span{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}}>
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ action.type === "mission" && action.missionType ? `${action.missionType}` : actionType.label }}</span>
													<span>{{ action.title }}</span>
												</span>
												{{ /if }}
											</li>
										{{ /for }}
										</ol>
										{{ /if }}
										{{ if release.loreActions }}
										<p><span class="fmt-label">Lore Entries</span></p>
										<ol class="supplemental">
										{{ for action of release.loreActions }}
											{{ set actionType = Object.hasOwn(actionTypes, action.type) ? actionTypes[action.type] : {} }}
											<li>
												{{ if action.url }}
												<a{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}} href="{{ action.url }}" target="_blank">
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}{{ action.length ? ` • ${action.length}` : "" }}</span>
													<span>{{ action.title }}</span>
												</a>
												{{ else }}
												<span{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}}>
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ action.type === "lore-book" ? `${action.description}` : actionType.label }}</span>
													<span>{{ action.title }}</span>
												</span>
												{{ /if }}
											</li>
										{{ /for }}
										</ol>
										{{ /if }}
									</div>
								</div>
								{{ /if }}
							{{ if release.entries }}<ol variant="headings">
							{{ for entry of release.entries }}
								<li g="story-entry">
									<h3 part="header"{{ if entry.banner }} style="--story-entry-header-img: url('/assets/images/banners/{{ entry.banner }}')"{{ /if }}><img g="icon" src="/assets/images/icons/{{ entry.icon }}"> {{ entry.title }}</h3>
									{{ if entry.synopsis }}<p part="summary">{{ entry.synopsis }}</p>{{ /if }}
									<div part="actions">
										{{ if entry.previewActions }}
										<p><span class="fmt-label">Preview</span></p>
										<ol class="supplemental">
										{{ for action of entry.previewActions }}
											{{ set actionType = Object.hasOwn(actionTypes, action.type) ? actionTypes[action.type] : {} }}
											<li>
												{{ if action.url }}
												<a{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}} href="{{ action.url }}" target="_blank">
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}{{ action.length ? ` • ${action.length}` : "" }}</span>
													<span>{{ action.title }}</span>
												</a>
												{{ else }}
												<span{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}}>
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ action.type === "mission" && action.missionType ? `${action.missionType}` : actionType.label }}</span>
													<span>{{ action.title }}</span>
												</span>
												{{ /if }}
											</li>
										{{ /for }}
										</ol>
										{{ /if }}
										{{ if entry.actions }}
										<p><span class="fmt-label">Core Content</span></p>
										<ol>
										{{ for action of entry.actions }}
											{{ set actionType = Object.hasOwn(actionTypes, action.type) ? actionTypes[action.type] : {} }}
											<li>
												{{ if action.url }}
												<a target="_blank"{{ action.description ? ` title="${action.description}"` : ''}} href="{{ action.url }}" target="_blank">
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}{{ action.length ? ` • ${action.length}` : "" }}</span>
													<span>{{ action.title }}</span>
												</a>
												{{ else }}
												<span{{ action.description ? ` title="${action.description}"` : ''}}>
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ action.type === "mission" && action.missionType ? `${action.missionType}` : actionType.label }}</span>
													<span>{{ action.title }}</span>
												</span>
												{{ /if }}
											</li>
										{{ /for }}
										</ol>
										{{ /if }}
										{{ if entry.supplementalActions }}
										<p><span class="fmt-label">Additional Content</span></p>
										<ol class="supplemental">
										{{ for action of entry.supplementalActions }}
											{{ set actionType = Object.hasOwn(actionTypes, action.type) ? actionTypes[action.type] : {} }}
											<li>
												{{ if action.url }}
												<a{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}} href="{{ action.url }}" target="_blank">
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}{{ action.length ? ` • ${action.length}` : "" }}</span>
													<span>{{ action.title }}</span>
												</a>
												{{ else }}
												<span{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}}>
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ action.type === "mission" && action.missionType ? `${action.missionType}` : actionType.label }}</span>
													<span>{{ action.title }}</span>
												</span>
												{{ /if }}
											</li>
										{{ /for }}
										</ol>
										{{ /if }}
										{{ if entry.loreActions }}
										<p><span class="fmt-label">Lore Entries</span></p>
										<ol class="supplemental">
										{{ for action of entry.loreActions }}
											{{ set actionType = Object.hasOwn(actionTypes, action.type) ? actionTypes[action.type] : {} }}
											<li>
												{{ if action.url }}
												<a{{ action.description ? ` title="${action.description}"` : ''}}{{ action.supplemental ? ` class="supplemental"` : ''}} href="{{ action.url }}" target="_blank">
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ actionType.label }}{{ action.length ? ` • ${action.length}` : "" }}</span>
													<span>{{ action.title }}</span>
												</a>
												{{ else }}
												<span{{ action.supplemental ? ` class="supplemental"` : ''}}>
													<img g="icon" src="/assets/images/icons/{{ actionType.icon }}">
													<span>{{ action.type === "lore-book" ? `${action.description}` : actionType.label }}</span>
													<span>{{ action.title }}</span>
												</span>
												{{ /if }}
											</li>
										{{ /for }}
										</ol>
										{{ /if }}
									</div>
								</li>
							{{ /for }}
							</ol>{{ /if }}
							</div>
							{{# character synopsis #}}
							{{ if hasCharacters }}
							<div
								id="{{ release.id }}-tabpanel-characters"
								aria-labelledby="{{ release.id }}-tab-characters"
								part="content"
								g-layout="prose"
								hidden=""
								{{ if hasEntries }}scroll-group="{{ release.id }}"{{ /if }}
							>
								{{ if release.characters?.length > 0 }}
								<ul g-layout="grid" variant="plain" style="align-items: start;">
								{{ for character of release.characters }}
									<li g="person">
										<img src="/assets/images/characters/{{ character.image }}">
										<span part="name">{{ character.name }}</span>
										<span part="title">{{ character.title }}</span>
										<span part="description">{{ character.description }}</span>
									</li>
								{{ /for }}
								</ul>
								{{ /if }}
							{{ if release.entries }}<ol variant="headings">
							{{ for entry of release.entries }}
								<li g="story-entry">
									<h3 part="header"{{ if entry.banner }} style="--story-entry-header-img: url('/assets/images/banners/{{ entry.banner }}')"{{ /if }}><img g="icon" src="/assets/images/icons/{{ entry.icon }}"> {{ entry.title }}</h3>
									<ul g-layout="grid" variant="plain">
										{{ for character of entry.characters }}
											<li g="person">
												<img src="/assets/images/characters/{{ character.image }}">
												<span part="name">{{ character.name }}</span>
												<span part="title">{{ character.title }}</span>
												<span part="description">{{ character.description }}</span>
											</li>
										{{ /for }}
									</ul>
								</li>
							{{ /for }}
							</ol>{{ /if }}
							</div>
							{{ /if }}
							<button commandfor="{{ release.id }}" command="close">Close</button>
						</dialog>
					</li>
					{{ /for }}
				</ol>
			</div>
			{{ /for }}
		</section>
		{{ /for }}
	</g-story>
{{ /layout }}