{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"armorStat": {
			"type": "integer",
			"description": "Armor stat value"
		},
		"attributeStrEnum": {
			"type": "string",
			"enum": [
				"solo",
				"group",
				"dmg_single_1",
				"dmg_single_2",
				"dmg_area_1",
				"dmg_area_2",
				"dmg_shields",
				"dmg_kinetic ---- maybe?",
				"dmg_elemental ---- maybe?",
				"flexible_0",
				"flexible_1",
				"focus_weapon",
				"focus_precision",
				"focus_ability",
				"focus_super",
				"focus_finisher",
				"range_close_0",
				"range_close_1",
				"range_long_0",
				"range_long_1",
				"movement",
				"defensive",
				"utility",
				"crowd_control_1",
				"crowd_control_2",
				"champion_counter_0",
				"champion_counter_1",
				"champion_counter_2",
				"champion_barrier",
				"champion_overload",
				"champion_unstoppable",
				"self_resource_gen_0",
				"self_resource_gen_1",
				"self_resource_gen_2",
				"self_gen_ammo",
				"self_gen_orbs",
				"self_gen_abilities",
				"self_gen_armor_charge",
				"self_buffs_0",
				"self_buffs_1",
				"self_buffs_2",
				"self_sustain_0",
				"self_sustain_1",
				"self_sustain_2",
				"team_resource_gen_0",
				"team_resource_gen_1",
				"team_resource_gen_2",
				"team_gen_ammo",
				"team_gen_orbs",
				"team_gen_abilities",
				"team_gen_armor_charge",
				"team_buffs_0",
				"team_buffs_1",
				"team_buffs_2",
				"team_sustain_0",
				"team_sustain_1",
				"team_sustain_2",
				"debuffs_0",
				"debuffs_1",
				"debuffs_2"
			]
		},
		"arcFragments": {
			"enum": [
				"Haste",
				"Instinct",
				"Beacons",
				"Resistance",
				"Momentum",
				"Shock",
				"Ions",
				"Discharge",
				"Frequency",
				"Focus",
				"Recharge",
				"Magnitude",
				"Amplitude",
				"Feedback",
				"Volts",
				"Brilliance"
			]
		},
		"arcGrenades": {
			"enum": [
				"Lightning Grenade",
				"Storm Grenade",
				"Flashbang Grenade",
				"Pulse Grenade",
				"Skip Grenade",
				"Flux Grenade",
				"Arcbolt Grenade"
			]
		},
		"weapon": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"description": "Main weapon classification"
				},
				"subtype": {
					"type": "string",
					"description": "Weapon frame"
				},
				"name": {
					"type": "string",
					"description": "Specific name of a weapon"
				},
				"element": {
					"type": "string",
					"description": "Elemental energy of the weapon"
				},
				"perks": {
					"type": "array",
					"description": "Specific perks for weapons that have randomly-rolled perks",
					"items": {
						"type": "string"
					}
				},
				"mod": {
					"type": "string",
					"description": "Mod to slot into the weapon"
				},
				"ammo": {
					"type": "string",
					"description": "Ammo type used by the weapon. All weapons in the power slot use heavy ammo so there is no need to specify"
				},
				"exotic": {
					"type": "boolean",
					"description": "Whether or not this is the slot that contains the exotic weapon for the build"
				}
			}
		},
		"armorMods": {
			"type": "array",
			"description": "List of armor mods to be used with armor in the specified slot",
			"items": { "type": "string", "description": "Individual armor mod" },
			"minItems": 0,
			"maxItems": 3
		},
		"cosmetic": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"description": "Name of the item or ornament"
				},
				"shader": {
					"type": "string",
					"description": "Name of the shader that is applied"
				}
			}
		}
	},
	"type": "object",
	"properties": {
		"$schema": { "type": "string" },
		"title": { "type": "string", "description": "" },
		"status": {
			"type": "string",
			"description": "Current state of the build",
			"enum": ["draft", "ready", "outdated"]
		},
		"description": { "type": "string", "description": "" },
		"playstyle": {
			"type": "array",
			"items": { "type": "string" },
			"description": "Main points for what the build does and how it works"
		},
		"difficulty": {
			"type": "integer",
			"description": "WIP General indicator for the level of execution needed",
			"minimum": 0,
			"maximum": 2
		},
		"effectiveRating": { "type": "integer", "description": "WIP maybe" },
		"attributes": {
			"type": "array",
			"description": "Identifiers for defined build attributes. May be added individually or grouped in a single layer of nested arrays",
			"items": {
				"anyOf": [
					{
						"$ref": "#/$defs/attributeStrEnum"
					},
					{
						"type": "array",
						"items": {
							"$ref": "#/$defs/attributeStrEnum"
						}
					}
				]
			},
			"uniqueItems": true
		},
		"build": {
			"type": "object",
			"description": "",
			"properties": {
				"class": {
					"type": "string",
					"enum": ["hunter", "titan", "warlock"]
				},
				"subclass": {
					"type": "string"
				},
				"abilities": {
					"type": "object",
					"properties": {
						"super": {
							"type": "string"
						},
						"grenade": {
							"type": "string"
						},
						"melee": {
							"type": "string"
						},
						"class": {
							"type": "string"
						},
						"movement": {
							"type": "string"
						}
					}
				},
				"aspects": {
					"type": "array",
					"description": "Unique effects or ability modifications for the chosen subclass",
					"items": {
						"type": "string"
					},
					"uniqueItems": true
				},
				"fragments": {
					"type": "array",
					"description": "Passive effects common to all subclasses of a certain element",
					"items": {
						"type": "string"
					},
					"uniqueItems": true
				},
				"stats": {
					"type": "object",
					"description": "Base player stats from armor",
					"properties": {
						"class": {
							"$ref": "#/$defs/armorStat"
						},
						"health": {
							"$ref": "#/$defs/armorStat"
						},
						"grenade": {
							"$ref": "#/$defs/armorStat"
						},
						"melee": {
							"$ref": "#/$defs/armorStat"
						},
						"super": {
							"$ref": "#/$defs/armorStat"
						},
						"weapons": {
							"$ref": "#/$defs/armorStat"
						}
					}
				},
				"armor": {
					"type": "object",
					"properties": {
						"exotic": {
							"type": "string"
						},
						"set": {
							"type": "array",
							"items": {
								"type": "string"
							},
							"uniqueItems": true,
							"minItems": 1,
							"maxItems": 2
						},
						"mods": {
							"type": "object",
							"properties": {
								"helmet": { "$ref": "#/$defs/armorMods" },
								"arms": { "$ref": "#/$defs/armorMods" },
								"chest": { "$ref": "#/$defs/armorMods" },
								"legs": { "$ref": "#/$defs/armorMods" },
								"class": { "$ref": "#/$defs/armorMods" }
							}
						}
					}
				},
				"weapons": {
					"type": "object",
					"properties": {
						"kinetic": {
							"$ref": "#/$defs/weapon"
						},
						"energy": {
							"$ref": "#/$defs/weapon"
						},
						"power": {
							"$ref": "#/$defs/weapon"
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": { "class": { "const": "titan" } }
					},
					"then": {
						"properties": {
							"subclass": {
								"enum": [
									"striker",
									"sentinal",
									"sunbreaker",
									"behemoth",
									"berserker",
									"prismatic-titan"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": { "class": { "const": "hunter" } }
					},
					"then": {
						"properties": {
							"subclass": {
								"enum": [
									"arcstrider",
									"gunslinger",
									"nightstalker",
									"revenant",
									"threadrunner",
									"prismatic-hunter"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": { "subclass": { "const": "arcstrider" } }
					},
					"then": {
						"properties": {
							"abilities": {
								"properties": {
									"super": {
										"enum": ["Arc Staff", "Gathering Storm", "Storm's Edge"]
									},
									"grenade": {
										"$ref": "#/$defs/arcGrenades"
									},
									"melee": {
										"enum": ["Disorienting Blow", "Combination Blow"]
									},
									"class": {
										"enum": ["Gambler's Dodge", "Marksman's Dodge"]
									},
									"movement": {
										"enum": ["High Jump", "Strafe Jump", "Triple Jump", "Blink"]
									}
								}
							},
							"aspects": {
								"items": {
									"enum": [
										"Ascension",
										"Flow State",
										"Tempest Strike",
										"Combination Blow"
									]
								}
							},
							"fragments": {
								"items": {
									"$ref": "#/$defs/arcFragments"
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": { "class": { "const": "warlock" } }
					},
					"then": {
						"properties": {
							"subclass": {
								"enum": [
									"dawnblade",
									"voidwalker",
									"stormcaller",
									"shadebinder",
									"broodweaver",
									"prismatic-warlock"
								]
							}
						}
					}
				}
			]
		},
		"cosmetics": {
			"type": "object",
			"description": "",
			"properties": {
				"armor": {
					"type": "object",
					"properties": {
						"helmet": { "$ref": "#/$defs/cosmetic" },
						"arms": { "$ref": "#/$defs/cosmetic" },
						"chest": { "$ref": "#/$defs/cosmetic" },
						"legs": { "$ref": "#/$defs/cosmetic" },
						"class": { "$ref": "#/$defs/cosmetic" }
					}
				},
				"weapons": {
					"type": "object",
					"properties": {
						"kinetic": {
							"$ref": "#/$defs/cosmetic"
						},
						"energy": {
							"$ref": "#/$defs/cosmetic"
						},
						"power": {
							"$ref": "#/$defs/cosmetic"
						}
					}
				},
				"ghost": {
					"$ref": "#/$defs/cosmetic",
					"properties": {
						"projection": {
							"type": "string"
						}
					}
				},
				"emblem": {
					"type": "string"
				},
				"ship": {
					"$ref": "#/$defs/cosmetic",
					"properties": {
						"transmat": {
							"type": "string"
						}
					}
				},
				"vehicle": {
					"$ref": "#/$defs/cosmetic"
				}
			}
		}
	},
	"additionalProperties": false
}
